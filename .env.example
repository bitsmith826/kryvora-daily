# Konfigurasi Opsional Kryvora Daily Bot
# Salin file ini menjadi .env jika Anda ingin mengubah pengaturan default

# Kode referral bawaan (default: kode referral Anda)
DEFAULT_REFERRAL_CODE=651A7DCB2E

# Jeda waktu (detik) antar akun agar request tampak natural
DELAY_BETWEEN_WALLETS_SEC=3

# Otomatis menyelesaikan task onboarding (Connect Wallet + Add Network) untuk wallet baru
AUTO_ONBOARDING=true

# Otomatis reveal gacha box jika ada token yang belum dibuka
AUTO_GACHA_REVEAL=true
